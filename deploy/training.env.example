# 培训班教务系统运行配置示例。
# 复制为 .env 后按实际环境填写；本文件可被 shell 与 systemd 读取（KEY=value，不加引号）。
# .env 含敏感信息，权限应设为 600，且不要提交到版本库。

# 允许访问的主机名或 IP，逗号分隔。
ALLOWED_HOSTS=example.edu.cn,127.0.0.1,localhost
# 浏览器请求来源，逗号分隔。启用 HTTPS 时填 https:// 开头的完整来源。
CSRF_TRUSTED_ORIGINS=https://example.edu.cn
# 仅在 HTTPS 网关之后设为 1，此时启用安全 Cookie 与代理 SSL 头。
HTTPS_ONLY=0

# 实例数据目录，存放密钥与（未配置 PostgreSQL 时的）SQLite 数据库。
TRAINING_DATA=/opt/training/data

# PostgreSQL 连接参数。PGDATABASE 留空时使用 SQLite。
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=
PGUSER=training
PGPASSWORD=

# 可选的签到照片识别服务（学校批准的内网多模态接口）。
VISION_CHAT_URL=
VISION_MODEL=
VISION_TOKEN=
